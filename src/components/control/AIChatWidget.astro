---
// 站内 AI 问答浮窗
// 检索靠 Pagefind（全站已有的搜索索引），回答靠 /api/chat（Cloudflare Worker）
---

<div id="ai-chat" class="ai-chat">
	<button id="ai-chat-toggle" class="ai-chat-fab" type="button" aria-label="问 AI">
		<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ai-chat-icon">
			<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
		</svg>
	</button>

	<section id="ai-chat-panel" class="ai-chat-panel" hidden>
		<header class="ai-chat-header">
			<span>问问我写过什么</span>
			<button id="ai-chat-close" type="button" aria-label="关闭">×</button>
		</header>

		<div id="ai-chat-messages" class="ai-chat-messages">
			<div class="ai-msg ai-msg-bot">
				随便问，比如「这个博客都写了些什么」，我会翻完所有文章再回答。
			</div>
		</div>

		<form id="ai-chat-form" class="ai-chat-form">
			<input id="ai-chat-input" type="text" placeholder="问点什么…" autocomplete="off" maxlength="200" />
			<button id="ai-chat-send" type="submit">发送</button>
		</form>
	</section>
</div>

<style is:global>
	/* 用 is:global：消息气泡是 JS 动态创建的，Astro 的局部作用域样式加不到它们身上。
	   所有类名都以 ai- 开头，不会和站点其它样式打架。 */
	.ai-chat {
		position: fixed;
		right: 1.25rem;
		bottom: 1.25rem;
		z-index: 60;
	}

	.ai-chat-fab {
		width: 3.25rem;
		height: 3.25rem;
		border-radius: 9999px;
		background: var(--primary);
		color: #fff;
		display: flex;
		align-items: center;
		justify-content: center;
		box-shadow: 0 6px 20px rgba(0, 0, 0, 0.18);
		transition: transform 0.2s ease, opacity 0.2s ease;
	}
	.ai-chat-fab:hover {
		transform: scale(1.06);
	}
	.ai-chat-icon {
		width: 1.5rem;
		height: 1.5rem;
	}

	.ai-chat-panel {
		position: fixed;
		right: 1.25rem;
		bottom: 5rem;
		width: min(22rem, calc(100vw - 2.5rem));
		max-height: min(30rem, calc(100vh - 8rem));
		display: flex;
		flex-direction: column;
		border-radius: 1rem;
		overflow: hidden;
		background: var(--card-bg);
		box-shadow: 0 12px 40px rgba(0, 0, 0, 0.22);
		border: 1px solid var(--line-divider);
	}
	.ai-chat-panel[hidden] {
		display: none;
	}

	.ai-chat-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.75rem 1rem;
		font-weight: 700;
		font-size: 0.95rem;
		color: var(--primary);
		border-bottom: 1px solid var(--line-divider);
	}
	.ai-chat-header button {
		font-size: 1.25rem;
		line-height: 1;
		padding: 0 0.25rem;
		color: var(--btn-content);
		opacity: 0.6;
	}
	.ai-chat-header button:hover {
		opacity: 1;
	}

	.ai-chat-messages {
		flex: 1;
		overflow-y: auto;
		padding: 0.85rem;
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		font-size: 0.875rem;
		line-height: 1.6;
	}

	.ai-msg {
		padding: 0.55rem 0.75rem;
		border-radius: 0.75rem;
		white-space: pre-wrap;
		word-break: break-word;
	}
	.ai-msg-bot {
		background: var(--btn-plain-bg-hover);
		align-self: flex-start;
		max-width: 92%;
	}
	.ai-msg-user {
		background: var(--primary);
		color: #fff;
		align-self: flex-end;
		max-width: 92%;
	}
	.ai-msg-note {
		background: transparent;
		color: var(--btn-content);
		opacity: 0.6;
		align-self: center;
		font-size: 0.8rem;
	}
	.ai-msg-sources {
		background: transparent;
		align-self: flex-start;
		font-size: 0.78rem;
		opacity: 0.75;
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
	}
	.ai-msg-sources a {
		color: var(--primary);
		text-decoration: underline;
		text-decoration-style: dashed;
	}

	.ai-chat-form {
		display: flex;
		gap: 0.5rem;
		padding: 0.75rem;
		border-top: 1px solid var(--line-divider);
	}
	.ai-chat-form input {
		flex: 1;
		min-width: 0;
		padding: 0.5rem 0.75rem;
		border-radius: 0.5rem;
		background: var(--btn-plain-bg-hover);
		color: inherit;
		font-size: 0.875rem;
	}
	.ai-chat-form input:focus {
		outline: 2px solid var(--primary);
	}
	.ai-chat-form button {
		padding: 0.5rem 0.9rem;
		border-radius: 0.5rem;
		background: var(--primary);
		color: #fff;
		font-size: 0.875rem;
		transition: opacity 0.2s ease;
	}
	.ai-chat-form button:disabled {
		opacity: 0.5;
		cursor: not-allowed;
	}

	@media (max-width: 640px) {
		.ai-chat-panel {
			right: 0.75rem;
			left: 0.75rem;
			width: auto;
			bottom: 4.75rem;
			max-height: 70vh;
		}
	}
</style>

<script>
	type PagefindResult = {
		url: string;
		excerpt: string;
		meta?: { title?: string };
	};

	const toggle = document.getElementById("ai-chat-toggle");
	const panel = document.getElementById("ai-chat-panel");
	const closeButton = document.getElementById("ai-chat-close");
	const form = document.getElementById("ai-chat-form") as HTMLFormElement | null;
	const input = document.getElementById("ai-chat-input") as HTMLInputElement | null;
	const sendButton = document.getElementById("ai-chat-send") as HTMLButtonElement | null;
	const messages = document.getElementById("ai-chat-messages");

	function appendMessage(text: string, kind: "bot" | "user" | "note"): HTMLElement | null {
		if (!messages) return null;
		const node = document.createElement("div");
		node.className = `ai-msg ai-msg-${kind}`;
		node.textContent = text;
		messages.appendChild(node);
		messages.scrollTop = messages.scrollHeight;
		return node;
	}

	function appendSources(sources: { title?: string; url?: string }[]) {
		if (!messages || sources.length === 0) return;
		const wrapper = document.createElement("div");
		wrapper.className = "ai-msg ai-msg-sources";
		const label = document.createElement("span");
		label.textContent = "参考：";
		wrapper.appendChild(label);
		for (const source of sources) {
			if (!source.url) continue;
			const link = document.createElement("a");
			link.href = source.url;
			link.textContent = source.title?.trim() || source.url;
			wrapper.appendChild(link);
		}
		messages.appendChild(wrapper);
		messages.scrollTop = messages.scrollHeight;
	}

	function stripHtml(value: string): string {
		return value.replace(/<[^>]*>/g, "").replace(/\s+/g, " ").trim();
	}

	/** 用站内搜索索引找出和问题最相关的几段 */
	async function retrieve(query: string) {
		const pagefind = (window as unknown as { pagefind?: { search: (q: string) => Promise<{ results: { data: () => Promise<PagefindResult> }[] }> } }).pagefind;
		if (!pagefind?.search) return [];
		try {
			const response = await pagefind.search(query);
			const top = response.results.slice(0, 3);
			const items = await Promise.all(top.map((result) => result.data()));
			return items.map((item) => ({
				title: item.meta?.title ?? "",
				url: item.url,
				excerpt: stripHtml(item.excerpt ?? "").slice(0, 800),
			}));
		} catch (error) {
			console.warn("检索失败", error);
			return [];
		}
	}

	async function ask(question: string) {
		appendMessage(question, "user");
		const pending = appendMessage("正在翻我的文章…", "note");
		if (sendButton) sendButton.disabled = true;

		try {
			const context = await retrieve(question);
			if (pending) pending.textContent = "正在组织回答…";

			const response = await fetch("/api/chat", {
				method: "POST",
				headers: { "content-type": "application/json" },
				body: JSON.stringify({ q: question, context }),
			});

			const data = (await response.json().catch(() => ({}))) as {
				answer?: string;
				error?: string;
				sources?: { title?: string; url?: string }[];
			};

			pending?.remove();

			if (!response.ok || !data.answer) {
				appendMessage(data.error ?? "出错了，稍后再试", "bot");
				return;
			}

			appendMessage(data.answer, "bot");
			appendSources(data.sources ?? []);
		} catch (error) {
			pending?.remove();
			appendMessage("网络好像不太行，稍后再试一次", "bot");
			console.warn(error);
		} finally {
			if (sendButton) sendButton.disabled = false;
			input?.focus();
		}
	}

	toggle?.addEventListener("click", () => {
		if (!panel) return;
		panel.hidden = !panel.hidden;
		if (!panel.hidden) input?.focus();
	});

	closeButton?.addEventListener("click", () => {
		if (panel) panel.hidden = true;
	});

	form?.addEventListener("submit", (event) => {
		event.preventDefault();
		const question = input?.value.trim() ?? "";
		if (!question) return;
		if (input) input.value = "";
		void ask(question);
	});

	// 手机键盘弹出时，避免遮住面板顶部
	input?.addEventListener("focus", () => {
		window.setTimeout(() => {
			messages?.scrollTo({ top: messages.scrollHeight });
		}, 250);
	});
</script>
