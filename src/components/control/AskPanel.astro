---
// 笔记页的 AI 助手：右侧抽屉，流式输出 + 思考过程 + 工具调用
// 逻辑在 src/scripts/ask-panel.ts，这里只放结构和样式
---

<div id="ask" class="ask" data-open="false">
	<button id="ask-fab" class="ask-fab" type="button" aria-label="问 AI" aria-expanded="false" title="问 AI（⌘/Ctrl + J）">
		<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ask-fab-icon">
			<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
			<path d="M9.2 11.5h.01M12.5 11.5h.01M15.8 11.5h.01" stroke-width="2.4"></path>
		</svg>
	</button>

	<div id="ask-scrim" class="ask-scrim" hidden></div>

	<aside id="ask-panel" class="ask-panel" aria-hidden="true" aria-label="AI 助手">
		<header class="ask-head">
			<div class="ask-head-main">
				<b>AI 助手</b>
				<span id="ask-context" class="ask-context">可以直接问</span>
			</div>
			<div class="ask-head-actions">
				<button type="button" id="ask-new" title="清空对话，重新问">新对话</button>
				<button type="button" id="ask-close" aria-label="关闭">×</button>
			</div>
		</header>

		<div id="ask-log" class="ask-log" role="log" aria-live="polite">
			<div class="ask-welcome" id="ask-welcome">
				<p class="ask-welcome-title">我是这个博客的 AI 助手</p>
				<p class="ask-welcome-sub">本站笔记、通用技术问题、需要联网查的最新资料都可以问。我会按问题自己决定查哪里，不用每句都从笔记里找答案。</p>
				<div class="ask-chips" id="ask-suggests"></div>
			</div>
		</div>

		<form id="ask-form" class="ask-form">
			<textarea id="ask-input" rows="1" maxlength="500" placeholder="问点什么…（Enter 发送，Shift+Enter 换行）"></textarea>
			<div class="ask-form-actions">
				<span class="ask-hint" id="ask-hint"></span>
				<button type="button" id="ask-stop" class="ask-stop" hidden>停止</button>
				<button type="submit" id="ask-send" class="ask-send">发送</button>
			</div>
		</form>
	</aside>
</div>

<style is:global>
	/* 用 is:global：消息气泡、工具行都是 JS 动态建的，Astro 的作用域样式套不上。
	   类名统一以 ask- 开头，不会和站点其它样式打架。 */
	.ask {
		position: fixed;
		right: 1.25rem;
		bottom: 1.25rem;
		z-index: 70;
	}

	.ask-fab {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 3.25rem;
		height: 3.25rem;
		border-radius: 9999px;
		background: var(--primary);
		color: #fff;
		box-shadow: 0 6px 20px rgba(0, 0, 0, 0.18);
		transition: transform 0.2s ease, opacity 0.2s ease;
	}
	.ask-fab:hover {
		transform: scale(1.06);
	}
	.ask[data-open="true"] .ask-fab {
		opacity: 0;
		pointer-events: none;
		transform: scale(0.85);
	}
	.ask-fab-icon {
		width: 1.55rem;
		height: 1.55rem;
	}

	.ask-scrim {
		position: fixed;
		inset: 0;
		background: rgba(0, 0, 0, 0.32);
		backdrop-filter: blur(1px);
	}

	.ask-panel {
		position: fixed;
		top: 0;
		right: 0;
		display: flex;
		flex-direction: column;
		width: min(28rem, 100vw);
		height: 100dvh;
		background: var(--card-bg);
		border-left: 1px solid var(--line-divider);
		box-shadow: -14px 0 44px rgba(0, 0, 0, 0.16);
		transform: translateX(102%);
		transition: transform 0.26s cubic-bezier(0.22, 0.8, 0.35, 1);
		visibility: hidden;
		color: var(--btn-content);
		font-size: 0.9rem;
	}
	.ask[data-open="true"] .ask-panel {
		transform: translateX(0);
		visibility: visible;
	}

	/* ---------- 头部 ---------- */
	.ask-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		padding: 0.7rem 0.85rem;
		border-bottom: 1px solid var(--line-divider);
		background: var(--card-bg);
	}
	.ask-head-main {
		display: flex;
		flex-direction: column;
		min-width: 0;
		gap: 0.1rem;
	}
	.ask-head-main b {
		font-size: 0.92rem;
		color: var(--primary);
	}
	.ask-context {
		font-size: 0.72rem;
		color: var(--btn-content);
		opacity: 0.62;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		max-width: 15rem;
	}
	.ask-head-actions {
		display: flex;
		align-items: center;
		gap: 0.15rem;
	}
	.ask-head-actions button {
		font-size: 0.74rem;
		padding: 0.3rem 0.5rem;
		border-radius: 0.5rem;
		color: var(--btn-content);
		opacity: 0.7;
		transition: background 0.16s ease, opacity 0.16s ease;
	}
	.ask-head-actions button:hover {
		opacity: 1;
		background: var(--btn-plain-bg-hover);
	}
	#ask-close {
		font-size: 1.25rem;
		line-height: 1;
		padding: 0 0.35rem;
	}

	/* ---------- 消息区 ---------- */
	.ask-log {
		flex: 1;
		overflow-y: auto;
		overflow-x: hidden;
		overscroll-behavior: contain;
		padding: 0.85rem;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.ask-welcome {
		padding: 0.2rem 0.1rem 0.4rem;
	}
	.ask-welcome.is-hidden {
		display: none;
	}
	.ask-welcome-title {
		font-size: 0.9rem;
		font-weight: 600;
		margin-bottom: 0.3rem !important;
	}
	.ask-welcome-sub {
		font-size: 0.78rem;
		line-height: 1.65;
		opacity: 0.66;
	}
	.ask-chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-top: 0.75rem;
	}
	.ask-chip {
		font-size: 0.76rem;
		padding: 0.32rem 0.6rem;
		border-radius: 999px;
		background: var(--btn-plain-bg-hover);
		color: var(--btn-content);
		cursor: pointer;
		transition: background 0.16s ease;
	}
	.ask-chip:hover {
		background: var(--primary);
		color: #fff;
	}

	.ask-msg-user {
		align-self: flex-end;
		max-width: 88%;
		padding: 0.55rem 0.75rem;
		border-radius: 0.85rem 0.85rem 0.25rem 0.85rem;
		background: var(--primary);
		color: #fff;
		white-space: pre-wrap;
		word-break: break-word;
		font-size: 0.86rem;
		line-height: 1.6;
	}

	.ask-turn {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		min-width: 0;
		max-width: 100%;
	}

	/* ---------- 步骤（状态 / 工具 / 思考） ---------- */
	.ask-steps {
		display: flex;
		flex-direction: column;
		gap: 0.28rem;
		min-width: 0;
		max-width: 100%;
		overflow: hidden;
		padding: 0.5rem 0.6rem;
		border-radius: 0.7rem;
		background: var(--btn-plain-bg-hover);
		font-size: 0.75rem;
		opacity: 0.95;
	}
	.ask-steps.is-done {
		opacity: 0.62;
	}

	.ask-step,
	.ask-tool {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.35rem 0.45rem;
		line-height: 1.5;
	}
	.ask-step-text {
		flex: 1;
		min-width: 0;
	}
	.ask-tool-name {
		flex: 0 0 auto;
		white-space: nowrap;
	}
	.ask-tool[data-state="done"] {
		opacity: 0.72;
	}
	.ask-tool-name {
		font-weight: 600;
		color: var(--btn-content);
	}
	.ask-tool-args {
		flex: 0 1 auto;
		min-width: 0;
		font-family: "JetBrains Mono Variable", ui-monospace, monospace;
		font-size: 0.7rem;
		opacity: 0.6;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		max-width: 9rem;
	}
	.ask-tool-summary {
		margin-left: auto;
		flex: 0 1 auto;
		min-width: 0;
		max-width: 55%;
		overflow: hidden;
		text-overflow: ellipsis;
		font-size: 0.7rem;
		opacity: 0.7;
		white-space: nowrap;
	}

	.ask-dot {
		width: 0.44rem;
		height: 0.44rem;
		flex: 0 0 0.44rem;
		border-radius: 999px;
		background: var(--primary);
		animation: ask-pulse 1.1s ease-in-out infinite;
	}
	.ask-tool[data-state="done"] .ask-dot,
	.ask-step[data-done="true"] .ask-dot {
		animation: none;
		background: oklch(0.68 0.13 155);
	}

	@keyframes ask-pulse {
		0%,
		100% {
			opacity: 0.35;
			transform: scale(0.85);
		}
		50% {
			opacity: 1;
			transform: scale(1);
		}
	}

	.ask-think {
		margin-top: 0.15rem;
	}
	.ask-think summary {
		cursor: pointer;
		font-size: 0.72rem;
		opacity: 0.7;
		list-style: none;
		user-select: none;
	}
	.ask-think summary::-webkit-details-marker {
		display: none;
	}
	.ask-think summary::before {
		content: "▸ ";
		opacity: 0.6;
	}
	.ask-think[open] summary::before {
		content: "▾ ";
	}
	.ask-think-body {
		margin-top: 0.3rem;
		padding: 0.4rem 0.5rem;
		border-radius: 0.5rem;
		background: color-mix(in oklab, var(--btn-plain-bg-hover) 70%, transparent);
		font-size: 0.72rem;
		line-height: 1.65;
		opacity: 0.75;
		white-space: pre-wrap;
		max-height: 12rem;
		overflow-y: auto;
	}

	/* ---------- 回答正文 ---------- */
	.ask-answer {
		min-width: 0;
		max-width: 100%;
		overflow-wrap: anywhere;
		font-size: 0.87rem;
		line-height: 1.72;
		word-break: break-word;
	}
	.ask-answer p {
		margin: 0 0 0.5rem;
	}
	.ask-answer p:last-child {
		margin-bottom: 0;
	}
	.ask-answer h3,
	.ask-answer h4 {
		font-size: 0.88rem;
		font-weight: 700;
		margin: 0.6rem 0 0.35rem;
	}
	.ask-answer ul,
	.ask-answer ol {
		margin: 0 0 0.5rem;
		padding-left: 1.1rem;
	}
	.ask-answer li {
		margin: 0.15rem 0;
	}
	.ask-answer code {
		font-family: "JetBrains Mono Variable", ui-monospace, monospace;
		font-size: 0.82em;
		padding: 0.1rem 0.3rem;
		border-radius: 0.3rem;
		background: var(--btn-plain-bg-hover);
	}
	.ask-answer pre {
		margin: 0.5rem 0;
		padding: 0.6rem 0.7rem;
		border-radius: 0.6rem;
		background: var(--codeblock-bg, var(--btn-plain-bg-hover));
		overflow-x: auto;
	}
	.ask-answer pre code {
		background: none;
		padding: 0;
		font-size: 0.78rem;
		line-height: 1.6;
	}
	.ask-answer a {
		color: var(--primary);
		text-decoration: underline;
		text-decoration-style: dashed;
		text-underline-offset: 2px;
	}
	.ask-answer strong {
		font-weight: 700;
	}
	.ask-caret {
		display: inline-block;
		width: 0.45rem;
		height: 0.95rem;
		margin-left: 0.1rem;
		vertical-align: -0.12rem;
		border-radius: 1px;
		background: var(--primary);
		animation: ask-blink 1s steps(2, start) infinite;
	}
	@keyframes ask-blink {
		50% {
			opacity: 0;
		}
	}

	.ask-sources {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		font-size: 0.73rem;
	}
	.ask-sources {
		align-items: center;
	}
	.ask-sources-label {
		width: 100%;
		font-size: 0.68rem;
		opacity: 0.55;
	}
	.ask-sources a {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		padding: 0.2rem 0.5rem;
		border-radius: 999px;
		background: var(--btn-plain-bg-hover);
		color: var(--btn-content);
		text-decoration: none;
		max-width: 100%;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.ask-sources a:hover {
		background: var(--primary);
		color: #fff;
	}
	.ask-source-id {
		flex: 0 0 auto;
		font-family: "JetBrains Mono Variable", ui-monospace, monospace;
		font-size: 0.64rem;
		opacity: 0.65;
	}
	.ask-source-kind {
		flex: 0 0 auto;
		font-size: 0.62rem;
		padding: 0 0.28rem;
		border-radius: 0.25rem;
		background: color-mix(in oklab, var(--primary) 14%, transparent);
		color: var(--primary);
	}
	.ask-sources a[data-kind="web"] .ask-source-kind {
		background: color-mix(in oklab, oklch(0.62 0.14 220) 16%, transparent);
		color: oklch(0.56 0.14 220);
	}

	.ask-meta {
		font-size: 0.68rem;
		opacity: 0.5;
		font-variant-numeric: tabular-nums;
	}
	.ask-error {
		padding: 0.5rem 0.6rem;
		border-radius: 0.6rem;
		background: color-mix(in oklab, oklch(0.62 0.18 25) 14%, transparent);
		color: oklch(0.52 0.17 25);
		font-size: 0.8rem;
	}
	html.dark .ask-error {
		color: oklch(0.78 0.14 25);
	}

	/* ---------- 输入区 ---------- */
	.ask-form {
		border-top: 1px solid var(--line-divider);
		padding: 0.6rem 0.7rem 0.5rem;
		background: var(--card-bg);
	}
	.ask-form textarea {
		width: 100%;
		resize: none;
		max-height: 7rem;
		padding: 0.5rem 0.6rem;
		border-radius: 0.6rem;
		border: 1px solid var(--line-divider);
		background: var(--btn-plain-bg-hover);
		color: inherit;
		font-family: inherit;
		font-size: 0.86rem;
		line-height: 1.55;
		outline: none;
	}
	.ask-form textarea:focus {
		border-color: var(--primary);
	}
	.ask-form-actions {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		margin-top: 0.45rem;
	}
	.ask-hint {
		font-size: 0.68rem;
		opacity: 0.55;
		flex: 1;
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.ask-send,
	.ask-stop {
		font-size: 0.78rem;
		padding: 0.38rem 0.8rem;
		border-radius: 0.55rem;
		background: var(--primary);
		color: #fff;
		transition: opacity 0.16s ease;
	}
	.ask-stop {
		background: var(--btn-plain-bg-hover);
		color: var(--btn-content);
	}
	.ask-send:disabled {
		opacity: 0.45;
		cursor: not-allowed;
	}

	@media (max-width: 640px) {
		.ask {
			right: 1rem;
			bottom: 1rem;
		}
		.ask-panel {
			width: 100vw;
			border-left: 0;
		}
		.ask-scrim {
			background: rgba(0, 0, 0, 0.18);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.ask-panel,
		.ask-fab,
		.ask-dot,
		.ask-caret {
			transition: none;
			animation: none;
		}
	}
</style>

<script>
	import { initAskPanel } from "../../scripts/ask-panel";

	initAskPanel();
</script>
