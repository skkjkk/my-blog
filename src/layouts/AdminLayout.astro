---
// 数据台外壳：登录门 + 左侧导航 + 顶栏，各分页只负责声明自己的卡片
// 样式在 src/styles/admin.css，页面逻辑在 src/scripts/admin/（按 page 名动态加载）
import "../styles/variables.styl";
import "../styles/admin.css";
import Layout from "@layouts/Layout.astro";

interface Props {
	title?: string;
	/** 页面标识，决定加载哪个看板模块：overview / audience / engagement / content / ai / comments */
	page?: string;
}

const { title = "数据台", page = "overview" } = Astro.props;

const nav = [
	{
		href: "/admin/",
		label: "概览",
		hint: "关键指标、阅读与提问趋势",
		group: "数据",
	},
	{
		href: "/admin/audience/",
		label: "受众",
		hint: "谁在来、什么时候来、还回不回来",
		group: "数据",
	},
	{
		href: "/admin/engagement/",
		label: "参与",
		hint: "搜什么、问什么、刷什么",
		group: "数据",
	},
	{
		href: "/admin/content/",
		label: "内容",
		hint: "文章表现、写作节奏、总记不住的题",
		group: "数据",
	},
	{
		href: "/admin/ai/",
		label: "AI",
		hint: "AI 产品指标：用量、延迟、模型、成本",
		group: "数据",
	},
	{
		href: "/admin/comments/",
		label: "评论",
		hint: "审核、回复、屏蔽词",
		group: "管理",
	},
];

// 归一化当前路径：/admin/audience/ → /admin/audience
const current = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isActive = (href: string) => {
	const target = href.replace(/\/+$/, "") || "/";
	return target === "/admin" ? current === "/admin" : current === target;
};
const groups = ["数据", "管理"];
---

<Layout title={title} noAIChat>
	<main class="dash" id="dash" data-page={page}>
		<!-- ================= 登录 ================= -->
		<section class="gate" id="gate" hidden>
			<div class="gate-card">
				<span class="gate-lock" aria-hidden="true">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
						<rect x="4" y="10.5" width="16" height="9.5" rx="3"></rect>
						<path d="M8 10.5V7a4 4 0 0 1 8 0v3.5"></path>
					</svg>
				</span>
				<h1>数据台</h1>
				<p>只给博主自己看。输密码进入，数据不对任何访客公开。</p>
				<form id="login-form" class="gate-form">
					<input id="password" type="password" placeholder="后台密码" autocomplete="current-password" />
					<button type="submit">进入</button>
				</form>
				<p class="gate-error" id="login-error" hidden></p>
				<a class="gate-back" href="/">← 回博客</a>
			</div>
		</section>

		<!-- ================= 数据台 ================= -->
		<div id="console" hidden>
			<aside class="side">
				<div class="brand side-brand">
					<span class="brand-mark">W</span>
					<div class="brand-text">
						<h1>数据台</h1>
						<p id="stamp">读取中…</p>
					</div>
				</div>

				{groups.map((group) => (
					<>
						<span class="side-group">{group}</span>
						<nav class="side-nav" aria-label={`数据台导航 · ${group}`}>
							{nav
								.filter((item) => item.group === group)
								.map((item) => (
									<a
										href={item.href}
										title={item.hint}
										class:list={["side-link", { "is-active": isActive(item.href) }]}
										aria-current={isActive(item.href) ? "page" : undefined}
										data-no-swup
									>
										<i></i>
										{item.label}
									</a>
								))}
						</nav>
					</>
				))}
			</aside>

			<div class="work">
				<header class="topbar">
					<div class="toolbar">
						<div class="seg" id="range-seg" role="group" aria-label="时间范围"></div>
						<button type="button" class="btn" id="refresh">刷新</button>
						<a class="btn" href="/">回博客</a>
						<button type="button" class="btn" id="logout">退出</button>
					</div>
				</header>

				<slot />

				<footer class="foot">
					<span>统计时区 GMT+8 · 不记录访客 IP · 数据仅博主可见</span>
				</footer>
			</div>
		</div>
	</main>
</Layout>

<script>
	import { initAdminPage } from "../scripts/admin/pages";
	import { initShell } from "../scripts/admin/core/shell";

	const page = document.getElementById("dash")?.dataset.page ?? "";
	void initAdminPage(page).then((handled) => {
		// 兜底：注册表里没有的页面至少要把登录门跑起来，别白屏
		if (!handled) initShell({ page: page || "unknown", load: async () => "ok" });
	});
</script>
