---
import "@fontsource-variable/jetbrains-mono";
import Layout from "@layouts/Layout.astro";
---

<Layout title="数据台">
	<main class="dash" id="dash">
		<!-- 登录 -->
		<section class="gate" id="gate" hidden>
			<div class="gate-inner">
				<p class="kicker">WKB / 数据台</p>
				<h1 class="gate-title">只给博主自己看</h1>
				<p class="gate-sub">输入后台密码。数据不会对任何访客公开。</p>
				<form id="login-form" class="gate-form">
					<input id="password" type="password" placeholder="后台密码" autocomplete="current-password" />
					<button type="submit">进入</button>
				</form>
				<p class="gate-error" id="login-error" hidden></p>
			</div>
		</section>

		<!-- 数据台 -->
		<div id="console" hidden>
			<header class="masthead">
				<div class="masthead-left">
					<p class="kicker">WKB · 数据台</p>
					<h1 class="masthead-title">博客编辑部</h1>
				</div>
				<div class="masthead-right">
					<p class="stamp" id="stamp">——</p>
					<div class="controls">
						<a class="ghost" href="/">← 回博客</a>
						<div class="seg" role="group" aria-label="时间范围">
							<button type="button" data-range="7">7 天</button>
							<button type="button" data-range="14" class="is-active">14 天</button>
							<button type="button" data-range="30">30 天</button>
						</div>
						<button type="button" class="ghost" id="refresh">刷新</button>
						<button type="button" class="ghost" id="logout">退出</button>
					</div>
				</div>
			</header>

			<div class="rule"></div>

			<!-- 数字条 -->
			<section class="ledger" id="ledger"></section>

			<div class="rule"></div>

			<!-- 趋势 -->
			<section class="block trend-block">
				<div class="block-head">
					<h2>阅读趋势</h2>
					<p class="block-note" id="trend-note"></p>
				</div>
				<div class="chart-wrap">
					<svg id="trend" class="chart" viewBox="0 0 800 260" preserveAspectRatio="none" aria-label="阅读趋势"></svg>
				</div>
				<div class="chart-axis" id="trend-axis"></div>
			</section>

			<div class="rule"></div>

			<div class="split">
				<!-- 热门 -->
				<section class="block">
					<div class="block-head">
						<h2>热门页面</h2>
						<p class="block-note">按阅读次数</p>
					</div>
					<ol class="ranking" id="ranking"></ol>
				</section>

				<!-- AI -->
				<section class="block">
					<div class="block-head">
						<h2>AI 助手</h2>
						<p class="block-note">站内问答的使用情况</p>
					</div>
					<div class="ai-panel">
						<div class="ring-wrap">
							<svg class="ring" viewBox="0 0 120 120" aria-label="成功率">
								<circle class="ring-track" cx="60" cy="60" r="52"></circle>
								<circle class="ring-value" id="ring" cx="60" cy="60" r="52"></circle>
							</svg>
							<div class="ring-label">
								<strong id="ring-value">—</strong>
								<span>成功率</span>
							</div>
						</div>
						<dl class="ai-facts" id="ai-facts"></dl>
					</div>
					<div class="models" id="models"></div>
				</section>
			</div>

			<div class="rule"></div>

			<!-- 访问时段 -->
			<section class="block">
				<div class="block-head">
					<h2>读者什么时候来</h2>
					<p class="block-note" id="hours-note">按小时分布</p>
				</div>
				<div class="heat" id="hours"></div>
				<div class="heat-axis">
					<span>0</span><span>6</span><span>12</span><span>18</span><span>23</span>
				</div>
			</section>

			<div class="rule"></div>

			<div class="split">
				<!-- 写作节奏 -->
				<section class="block">
					<div class="block-head">
						<h2>写作节奏</h2>
						<p class="block-note" id="rhythm-note"></p>
					</div>
					<div class="months" id="months"></div>
					<dl class="content-facts" id="content-facts"></dl>
				</section>

				<!-- 标签 -->
				<section class="block">
					<div class="block-head">
						<h2>标签分布</h2>
						<p class="block-note" id="tags-note"></p>
					</div>
					<div class="tagbars" id="tags"></div>
				</section>
			</div>

			<div class="rule"></div>

			<div class="split">
				<!-- 站内搜索 -->
				<section class="block">
					<div class="block-head">
						<h2>读者在搜什么</h2>
						<p class="block-note" id="search-note"></p>
					</div>
					<ol class="ranking compact" id="searches"></ol>
				</section>

				<!-- 被问最多的文章 -->
				<section class="block">
					<div class="block-head">
						<h2>最让人困惑的文章</h2>
						<p class="block-note">AI 检索命中最多的文章</p>
					</div>
					<ol class="ranking compact" id="ai-paths"></ol>
				</section>
			</div>

			<div class="rule"></div>

			<!-- 提问记录 -->
			<section class="block">
				<div class="block-head">
					<h2>最近的提问</h2>
					<p class="block-note">访客都问了什么</p>
				</div>
				<ul class="log" id="log"></ul>
			</section>

			<footer class="foot">
				<span id="foot-note">统计时区 GMT+8 · 不记录访客 IP</span>
			</footer>
		</div>
	</main>
</Layout>

<style is:global>
	#ai-chat {
		display: none !important;
	}

	.dash {
		--paper: #f4f2ec;
		--ink: #17170f;
		--ink-soft: #5f5d51;
		--ink-faint: #918d7d;
		--hair: #dcd7c9;
		--accent: #b23a1f;
		--accent-soft: rgba(178, 58, 31, 0.085);
		--leaf: #35564a;
		--mono: "JetBrains Mono Variable", ui-monospace, SFMono-Regular, Menlo, monospace;
		--serif: "Songti SC", "Noto Serif SC", "Source Han Serif SC", "SimSun", Georgia, serif;
		--sans: "PingFang SC", "Microsoft YaHei", "Hiragino Sans GB", system-ui, sans-serif;

		min-height: 100vh;
		padding: 0 1.25rem 4rem;
		background-color: var(--paper);
		background-image: radial-gradient(circle at 12% -10%, rgba(178, 58, 31, 0.06), transparent 45%),
			radial-gradient(circle at 92% 4%, rgba(53, 86, 74, 0.07), transparent 40%);
		color: var(--ink);
		font-family: var(--sans);
		-webkit-font-smoothing: antialiased;
	}
	html.dark .dash {
		--paper: #121210;
		--ink: #ece8dd;
		--ink-soft: #a5a094;
		--ink-faint: #726d62;
		--hair: #2b2a25;
		--accent: #e4654a;
		--accent-soft: rgba(228, 101, 74, 0.14);
		--leaf: #7fa595;
		background-image: radial-gradient(circle at 10% -8%, rgba(228, 101, 74, 0.1), transparent 45%),
			radial-gradient(circle at 94% 2%, rgba(127, 165, 149, 0.08), transparent 40%);
	}

	.dash * {
		box-sizing: border-box;
	}

	/* hidden 属性要压过 display:grid/flex，否则登录页和数据台会同时出现 */
	.dash [hidden] {
		display: none !important;
	}

	.kicker {
		margin: 0;
		font-family: var(--mono);
		font-size: 0.62rem;
		letter-spacing: 0.24em;
		text-transform: uppercase;
		color: var(--ink-faint);
	}

	/* ---------- 登录 ---------- */
	.gate {
		min-height: 100vh;
		display: grid;
		place-items: center;
	}
	.gate-inner {
		width: min(24rem, 100%);
		text-align: center;
	}
	.gate-title {
		margin: 1.2rem 0 0.6rem;
		font-family: var(--serif);
		font-size: 2rem;
		font-weight: 600;
		letter-spacing: 0.02em;
	}
	.gate-sub {
		margin: 0 0 2rem;
		font-size: 0.82rem;
		line-height: 1.7;
		color: var(--ink-soft);
	}
	.gate-form {
		display: flex;
		gap: 0.5rem;
		border-bottom: 1px solid var(--hair);
		padding-bottom: 0.6rem;
	}
	.gate-form input {
		flex: 1;
		min-width: 0;
		background: transparent;
		border: 0;
		outline: none;
		font-family: var(--mono);
		font-size: 0.95rem;
		letter-spacing: 0.12em;
		color: var(--ink);
		padding: 0.4rem 0;
	}
	.gate-form input::placeholder {
		color: var(--ink-faint);
		letter-spacing: 0.04em;
	}
	.gate-form button {
		border: 0;
		background: var(--ink);
		color: var(--paper);
		font-size: 0.8rem;
		letter-spacing: 0.12em;
		padding: 0.5rem 1.1rem;
		cursor: pointer;
		transition: background 0.2s ease;
	}
	.gate-form button:hover {
		background: var(--accent);
	}
	.gate-error {
		margin: 1rem 0 0;
		font-size: 0.8rem;
		color: var(--accent);
	}

	/* ---------- 刊头 ---------- */
	.masthead {
		max-width: 78rem;
		margin: 0 auto;
		padding: 2.4rem 0 1.2rem;
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1.2rem;
	}
	.masthead-title {
		margin: 0.5rem 0 0;
		font-family: var(--serif);
		font-size: clamp(1.9rem, 5vw, 2.9rem);
		font-weight: 600;
		letter-spacing: 0.03em;
		line-height: 1.05;
	}
	.masthead-right {
		text-align: right;
	}
	.stamp {
		margin: 0 0 0.9rem;
		font-family: var(--mono);
		font-size: 0.7rem;
		letter-spacing: 0.1em;
		color: var(--ink-faint);
	}
	.controls {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.seg {
		display: inline-flex;
		border: 1px solid var(--hair);
	}
	.seg button {
		border: 0;
		background: transparent;
		color: var(--ink-soft);
		font-family: var(--mono);
		font-size: 0.68rem;
		letter-spacing: 0.08em;
		padding: 0.42rem 0.7rem;
		cursor: pointer;
		transition: all 0.18s ease;
	}
	.seg button + button {
		border-left: 1px solid var(--hair);
	}
	.seg button:hover {
		color: var(--ink);
	}
	.seg button.is-active {
		background: var(--ink);
		color: var(--paper);
	}
	.ghost {
		display: inline-flex;
		align-items: center;
		text-decoration: none;
		border: 1px solid var(--hair);
		background: transparent;
		color: var(--ink-soft);
		font-size: 0.7rem;
		letter-spacing: 0.1em;
		padding: 0.42rem 0.8rem;
		cursor: pointer;
		transition: all 0.18s ease;
	}
	.ghost:hover {
		color: var(--ink);
		border-color: var(--ink);
	}
	.rule {
		max-width: 78rem;
		margin: 0 auto;
		height: 1px;
		background: var(--hair);
	}
	.masthead + .rule {
		height: 3px;
		border-top: 1px solid var(--hair);
		border-bottom: 1px solid var(--hair);
		background: transparent;
	}

	/* ---------- 数字条 ---------- */
	.ledger {
		max-width: 78rem;
		margin: 0 auto;
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		border-bottom: 1px solid var(--hair);
	}
	.ledger-item {
		padding: 1.35rem 1.1rem 1.2rem;
		border-right: 1px solid var(--hair);
		animation: rise 0.5s cubic-bezier(0.22, 0.68, 0.28, 1) both;
	}
	.ledger-item:nth-child(4n) {
		border-right: 0;
	}
	.ledger-item:nth-child(n + 5) {
		border-top: 1px solid var(--hair);
	}
	.ledger-label {
		margin: 0 0 0.55rem;
		font-family: var(--mono);
		font-size: 0.62rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--ink-faint);
	}
	.ledger-value {
		display: flex;
		align-items: baseline;
		gap: 0.35rem;
		font-family: var(--mono);
		font-size: clamp(1.6rem, 4.4vw, 2.15rem);
		font-weight: 500;
		letter-spacing: -0.02em;
		line-height: 1;
		font-variant-numeric: tabular-nums;
	}
	.ledger-delta {
		font-family: var(--mono);
		font-size: 0.66rem;
		letter-spacing: 0.04em;
		color: var(--ink-faint);
	}
	.ledger-delta.up {
		color: var(--leaf);
	}
	.ledger-delta.down {
		color: var(--accent);
	}

	/* ---------- 区块 ---------- */
	.block {
		max-width: 78rem;
		margin: 0 auto;
		padding: 1.6rem 0 1.9rem;
	}
	.block-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1.2rem;
	}
	.block-head h2 {
		margin: 0;
		font-family: var(--serif);
		font-size: 1.15rem;
		font-weight: 600;
		letter-spacing: 0.04em;
	}
	.block-note {
		margin: 0;
		font-family: var(--mono);
		font-size: 0.64rem;
		letter-spacing: 0.1em;
		color: var(--ink-faint);
	}

	/* ---------- 趋势图 ---------- */
	.chart-wrap {
		position: relative;
		width: 100%;
		height: clamp(11rem, 34vw, 15rem);
	}
	.chart {
		width: 100%;
		height: 100%;
		overflow: visible;
	}
	.chart-grid line {
		stroke: var(--hair);
		stroke-width: 1;
		vector-effect: non-scaling-stroke;
	}
	.chart-area {
		fill: var(--accent-soft);
		opacity: 0;
		animation: fade 0.9s ease 0.25s forwards;
	}
	.chart-line {
		fill: none;
		stroke: var(--accent);
		stroke-width: 1.6;
		vector-effect: non-scaling-stroke;
		stroke-linejoin: round;
		stroke-linecap: round;
	}
	.chart-line.animate {
		stroke-dasharray: 2400;
		stroke-dashoffset: 2400;
		animation: draw 1.4s cubic-bezier(0.3, 0.8, 0.3, 1) forwards;
	}
	.chart-dot {
		fill: var(--paper);
		stroke: var(--accent);
		stroke-width: 1.6;
		vector-effect: non-scaling-stroke;
	}
	.chart-y {
		font-family: var(--mono);
		font-size: 9px;
		fill: var(--ink-faint);
	}
	.chart-axis {
		display: flex;
		justify-content: space-between;
		margin-top: 0.7rem;
		font-family: var(--mono);
		font-size: 0.62rem;
		letter-spacing: 0.08em;
		color: var(--ink-faint);
	}

	/* ---------- 热门榜 ---------- */
	.ranking {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.ranking li {
		display: grid;
		grid-template-columns: 2.1rem 1fr auto;
		align-items: baseline;
		gap: 0.7rem;
		padding: 0.75rem 0;
		border-bottom: 1px dashed var(--hair);
		animation: rise 0.5s cubic-bezier(0.22, 0.68, 0.28, 1) both;
	}
	.ranking li:last-child {
		border-bottom: 0;
	}
	.rank-no {
		font-family: var(--mono);
		font-size: 0.7rem;
		color: var(--accent);
		letter-spacing: 0.06em;
	}
	.rank-body {
		display: block;
		min-width: 0;
	}
	.rank-title {
		display: block;
		color: var(--ink);
		text-decoration: none;
		font-size: 0.9rem;
		line-height: 1.4;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.rank-title:hover {
		color: var(--accent);
	}
	.rank-track {
		display: block;
		margin-top: 0.45rem;
		height: 2px;
		background: var(--hair);
	}
	.rank-track i {
		display: block;
		height: 100%;
		background: var(--accent);
		width: 0;
		transition: width 0.9s cubic-bezier(0.3, 0.8, 0.3, 1);
	}
	.rank-count {
		font-family: var(--mono);
		font-size: 0.78rem;
		font-variant-numeric: tabular-nums;
		color: var(--ink-soft);
	}

	/* ---------- AI ---------- */
	.split {
		max-width: 78rem;
		margin: 0 auto;
		display: grid;
		grid-template-columns: 1.15fr 1fr;
		gap: 0 3rem;
	}
	/* 分栏里的 block 不要再用 auto 居中，否则两块会左右错开 */
	.split > .block {
		max-width: none;
		margin: 0;
	}

	.ai-panel {
		display: flex;
		align-items: center;
		gap: 1.6rem;
	}
	.ring-wrap {
		position: relative;
		width: 6.4rem;
		height: 6.4rem;
		flex-shrink: 0;
	}
	.ring {
		width: 100%;
		height: 100%;
		transform: rotate(-90deg);
	}
	.ring-track {
		fill: none;
		stroke: var(--hair);
		stroke-width: 5;
	}
	.ring-value {
		fill: none;
		stroke: var(--leaf);
		stroke-width: 5;
		stroke-linecap: round;
		stroke-dasharray: 327;
		stroke-dashoffset: 327;
		transition: stroke-dashoffset 1.2s cubic-bezier(0.3, 0.8, 0.3, 1);
	}
	.ring-label {
		position: absolute;
		inset: 0;
		display: grid;
		place-content: center;
		text-align: center;
	}
	.ring-label strong {
		font-family: var(--mono);
		font-size: 1.15rem;
		font-weight: 500;
		font-variant-numeric: tabular-nums;
	}
	.ring-label span {
		font-family: var(--mono);
		font-size: 0.55rem;
		letter-spacing: 0.14em;
		color: var(--ink-faint);
	}
	.ai-facts {
		margin: 0;
		display: grid;
		gap: 0.55rem;
		flex: 1;
		min-width: 0;
	}
	.ai-facts div {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.6rem;
		border-bottom: 1px dashed var(--hair);
		padding-bottom: 0.4rem;
	}
	.ai-facts dt {
		font-size: 0.74rem;
		color: var(--ink-soft);
		white-space: nowrap;
	}
	.ai-facts dd {
		margin: 0;
		font-family: var(--mono);
		font-size: 0.82rem;
		font-variant-numeric: tabular-nums;
	}
	.models {
		margin-top: 1rem;
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}
	.model-chip {
		display: inline-flex;
		flex-direction: column;
		border: 1px solid var(--hair);
		padding: 0.4rem 0.6rem;
		font-family: var(--mono);
		font-size: 0.6rem;
		letter-spacing: 0.04em;
		color: var(--ink-soft);
	}
	.model-chip b {
		color: var(--ink);
		font-weight: 500;
	}

	/* ---------- 提问日志 ---------- */
	.log {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.log li {
		display: grid;
		grid-template-columns: 5.6rem 1fr auto;
		align-items: baseline;
		gap: 0.9rem;
		padding: 0.7rem 0;
		border-bottom: 1px dashed var(--hair);
		animation: rise 0.45s cubic-bezier(0.22, 0.68, 0.28, 1) both;
	}
	.log li:last-child {
		border-bottom: 0;
	}
	.log-time {
		font-family: var(--mono);
		font-size: 0.66rem;
		color: var(--ink-faint);
		letter-spacing: 0.04em;
	}
	.log-q {
		font-size: 0.88rem;
		line-height: 1.5;
		overflow-wrap: anywhere;
	}
	.log-meta {
		font-family: var(--mono);
		font-size: 0.64rem;
		color: var(--ink-faint);
		white-space: nowrap;
	}
	.log-meta.bad {
		color: var(--accent);
	}
	.empty {
		padding: 1.4rem 0;
		font-size: 0.8rem;
		color: var(--ink-faint);
	}

	/* ---------- 访问时段热力 ---------- */
	.heat {
		display: grid;
		grid-template-columns: repeat(24, minmax(0, 1fr));
		gap: 2px;
		height: 4.5rem;
		align-items: end;
	}
	.heat i {
		display: block;
		background: var(--accent);
		border-radius: 1px 1px 0 0;
		min-height: 2px;
		transition: height 0.7s cubic-bezier(0.3, 0.8, 0.3, 1), opacity 0.3s ease;
	}
	.heat i:hover {
		opacity: 0.65;
	}
	.heat-axis {
		display: flex;
		justify-content: space-between;
		margin-top: 0.5rem;
		font-family: var(--mono);
		font-size: 0.6rem;
		color: var(--ink-faint);
	}

	/* ---------- 写作节奏 ---------- */
	.months {
		display: flex;
		align-items: flex-end;
		gap: 0.35rem;
		height: 5.5rem;
		margin-bottom: 1rem;
	}
	.month {
		flex: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: flex-end;
		gap: 0.35rem;
		height: 100%;
	}
	.month b {
		font-family: var(--mono);
		font-size: 0.62rem;
		font-weight: 500;
		color: var(--ink-soft);
	}
	.month i {
		display: block;
		width: 100%;
		background: var(--leaf);
		opacity: 0.9;
		min-height: 2px;
		transition: height 0.7s cubic-bezier(0.3, 0.8, 0.3, 1);
	}
	.month span {
		font-family: var(--mono);
		font-size: 0.58rem;
		color: var(--ink-faint);
		letter-spacing: 0.04em;
	}
	.content-facts {
		margin: 0;
		display: grid;
		gap: 0.45rem;
	}
	.content-facts div {
		display: flex;
		justify-content: space-between;
		border-bottom: 1px dashed var(--hair);
		padding-bottom: 0.4rem;
	}
	.content-facts dt {
		font-size: 0.74rem;
		color: var(--ink-soft);
	}
	.content-facts dd {
		margin: 0;
		font-family: var(--mono);
		font-size: 0.8rem;
	}

	/* ---------- 标签条 ---------- */
	.tagbars {
		display: grid;
		gap: 0.55rem;
	}
	.tagbar {
		display: grid;
		grid-template-columns: 5.5rem 1fr 2rem;
		align-items: center;
		gap: 0.6rem;
		font-size: 0.78rem;
	}
	.tagbar span:first-child {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		color: var(--ink-soft);
	}
	.tagbar em {
		display: block;
		height: 3px;
		background: var(--hair);
		font-style: normal;
	}
	.tagbar em i {
		display: block;
		height: 100%;
		background: var(--leaf);
		width: 0;
		transition: width 0.8s cubic-bezier(0.3, 0.8, 0.3, 1);
	}
	.tagbar b {
		font-family: var(--mono);
		font-size: 0.72rem;
		font-weight: 500;
		text-align: right;
		color: var(--ink-faint);
	}

	.ranking.compact li {
		padding: 0.55rem 0;
	}

	.foot {
		max-width: 78rem;
		margin: 0 auto;
		padding: 1.4rem 0 0;
		font-family: var(--mono);
		font-size: 0.62rem;
		letter-spacing: 0.1em;
		color: var(--ink-faint);
	}

	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(8px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}
	@keyframes draw {
		to {
			stroke-dashoffset: 0;
		}
	}
	@keyframes fade {
		to {
			opacity: 1;
		}
	}

	@media (max-width: 860px) {
		.split {
			grid-template-columns: 1fr;
		}
		.ledger {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
		.ledger-item:nth-child(2n) {
			border-right: 0;
		}
		.ledger-item:nth-child(odd) {
			border-right: 1px solid var(--hair);
		}
		.masthead-right {
			text-align: left;
			width: 100%;
		}
		.controls {
			justify-content: flex-start;
		}
		.log li {
			grid-template-columns: 1fr auto;
			row-gap: 0.25rem;
		}
		.log-time {
			grid-column: 1 / -1;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.dash * {
			animation: none !important;
			transition: none !important;
		}
	}
</style>

<script>
	type Overview = {
		generatedAt: string;
		today: string;
		range: number;
		views: {
			total: number;
			today: number;
			yesterday: number;
			series: { day: string; count: number }[];
			top: { path: string; count: number }[];
			hours: { hour: number; count: number }[];
			search: { total: number; top: { keyword: string; count: number }[] };
		};
		ai: {
			total: number;
			today: number;
			yesterday: number;
			avgMs: number;
			tokens: number;
			successRate: number;
			zeroHits: number;
			avgHits: number;
			topPaths: { path: string; count: number }[];
			series: { day: string; count: number }[];
			recent: { ts: string; question: string; model: string; ms: number; ok: number }[];
			models: { model: string; count: number }[];
		};
	};

	type PostMeta = { title: string; url: string; tags?: string[]; category?: string; published?: string; words?: number };

	const $ = <T extends HTMLElement = HTMLElement>(sel: string) => document.querySelector(sel) as T | null;

	let range = 14;
	let titles = new Map<string, string>();
	let postsCache: PostMeta[] = [];

	const fmtNum = (value: number) => value.toLocaleString("zh-CN");
	const pad = (value: number) => String(value).padStart(2, "0");

	/* 数字滚动 */
	function countUp(node: HTMLElement, target: number) {
		const duration = 700;
		const start = performance.now();
		function step(now: number) {
			const progress = Math.min(1, (now - start) / duration);
			const eased = 1 - (1 - progress) ** 3;
			node.textContent = fmtNum(Math.round(target * eased));
			if (progress < 1) requestAnimationFrame(step);
		}
		requestAnimationFrame(step);
	}

	function deltaHtml(today: number, yesterday: number) {
		if (yesterday === 0 && today === 0) return "";
		if (yesterday === 0) return `<span class="ledger-delta up">昨日 0</span>`;
		const diff = today - yesterday;
		const pct = Math.round((diff / yesterday) * 100);
		if (diff === 0) return `<span class="ledger-delta">持平</span>`;
		const cls = diff > 0 ? "up" : "down";
		const arrow = diff > 0 ? "▲" : "▼";
		return `<span class="ledger-delta ${cls}">${arrow} ${Math.abs(pct)}% · 昨日 ${fmtNum(yesterday)}</span>`;
	}

	function renderLedger(data: Overview) {
		const box = $("#ledger");
		if (!box) return;
		const tags = new Set<string>();
		const categories = new Set<string>();
		for (const post of postsCache) {
			for (const tag of post.tags ?? []) tags.add(tag);
			if (post.category) categories.add(post.category);
		}

		const items: { label: string; value: number; extra?: string; suffix?: string }[] = [
			{ label: "文章", value: postsCache.length, extra: `<span class="ledger-delta">${categories.size} 个分类</span>` },
			{ label: "标签", value: tags.size, extra: `<span class="ledger-delta">去重后</span>` },
			{ label: "今日阅读", value: data.views.today, extra: deltaHtml(data.views.today, data.views.yesterday) },
			{ label: "累计阅读", value: data.views.total, extra: `<span class="ledger-delta">${data.range} 天内 ${fmtNum(data.views.series.reduce((sum, row) => sum + row.count, 0))}</span>` },
			{ label: "AI 提问", value: data.ai.total, extra: deltaHtml(data.ai.today, data.ai.yesterday) },
			{ label: "AI 平均响应", value: Number((data.ai.avgMs / 1000).toFixed(1)), suffix: "s", extra: `<span class="ledger-delta">近 ${data.range} 天</span>` },
			{ label: "累计 tokens", value: data.ai.tokens, extra: `<span class="ledger-delta">模型调用量</span>` },
			{ label: "对话成功率", value: data.ai.successRate, suffix: "%", extra: `<span class="ledger-delta">${data.ai.total} 次中有 ${Math.round((data.ai.total * data.ai.successRate) / 100)} 次成功</span>` },
		];

		box.innerHTML = items
			.map(
				(item, index) => `
			<div class="ledger-item" style="animation-delay:${index * 45}ms">
				<p class="ledger-label">${item.label}</p>
				<div class="ledger-value"><span data-count="${item.value}">0</span>${item.suffix ? `<span style="font-size:0.8em;color:var(--ink-faint)">${item.suffix}</span>` : ""}</div>
				<div style="margin-top:0.5rem">${item.extra ?? ""}</div>
			</div>`,
			)
			.join("");

		for (const node of box.querySelectorAll<HTMLElement>("[data-count]")) {
			countUp(node, Number(node.dataset.count ?? 0));
		}
	}

	function fillSeries(series: { day: string; count: number }[], days: number) {
		const map = new Map(series.map((row) => [row.day, row.count]));
		const out: { day: string; count: number }[] = [];
		for (let i = days - 1; i >= 0; i--) {
			const date = new Date(Date.now() + 8 * 3600 * 1000 - i * 86400000);
			const key = date.toISOString().slice(0, 10);
			out.push({ day: key, count: map.get(key) ?? 0 });
		}
		return out;
	}

	function renderTrend(data: Overview) {
		const svg = $("#trend") as unknown as SVGSVGElement | null;
		if (!svg) return;
		const days = fillSeries(data.views.series, data.range);
		const width = 800;
		const height = 260;
		const padTop = 18;
		const padBottom = 26;
		const max = Math.max(4, ...days.map((d) => d.count));
		const stepX = days.length > 1 ? width / (days.length - 1) : width;
		const yOf = (value: number) => padTop + (1 - value / max) * (height - padTop - padBottom);

		const points = days.map((item, index) => `${(index * stepX).toFixed(1)},${yOf(item.count).toFixed(1)}`);
		const linePath = `M ${points.join(" L ")}`;
		const areaPath = `${linePath} L ${width},${height - padBottom} L 0,${height - padBottom} Z`;

		const gridLines = [0, 0.5, 1]
			.map((ratio) => {
				const y = padTop + ratio * (height - padTop - padBottom);
				const label = Math.round(max * (1 - ratio));
				return `<line x1="0" y1="${y}" x2="${width}" y2="${y}" />
					<text class="chart-y" x="0" y="${y - 5}">${label}</text>`;
			})
			.join("");

		const dots = days
			.map((item, index) => {
				if (item.count === 0) return "";
				return `<circle class="chart-dot" cx="${(index * stepX).toFixed(1)}" cy="${yOf(item.count).toFixed(1)}" r="2.6" />`;
			})
			.join("");

		svg.innerHTML = `
			<g class="chart-grid">${gridLines}</g>
			<path class="chart-area" d="${areaPath}" />
			<path class="chart-line animate" d="${linePath}" />
			${dots}
		`;

		const axis = $("#trend-axis");
		if (axis) {
			const picks = days.length <= 8 ? days : days.filter((_, index) => index % Math.ceil(days.length / 7) === 0 || index === days.length - 1);
			axis.innerHTML = picks.map((item) => `<span>${Number(item.day.slice(5, 7))}/${Number(item.day.slice(8, 10))}</span>`).join("");
		}

		const note = $("#trend-note");
		if (note) {
			const sum = days.reduce((acc, row) => acc + row.count, 0);
			note.textContent = `${data.range} 天共 ${fmtNum(sum)} 次 · 日均 ${(sum / data.range).toFixed(1)}`;
		}
	}

	function renderRanking(data: Overview) {
		const box = $("#ranking");
		if (!box) return;
		if (data.views.top.length === 0) {
			box.innerHTML = `<li class="empty" style="display:block;border:0">还没有数据，等有人访问后就会出现</li>`;
			return;
		}
		const max = Math.max(...data.views.top.map((item) => item.count));
		box.innerHTML = data.views.top
			.map((item, index) => {
				const title = titles.get(item.path) ?? item.path;
				return `<li style="animation-delay:${index * 45}ms">
					<span class="rank-no">${pad(index + 1)}</span>
					<span class="rank-body">
						<a class="rank-title" href="${item.path}">${title}</a>
						<span class="rank-track"><i data-width="${Math.round((item.count / max) * 100)}"></i></span>
					</span>
					<span class="rank-count">${fmtNum(item.count)}</span>
				</li>`;
			})
			.join("");
		requestAnimationFrame(() => {
			requestAnimationFrame(() => {
				for (const bar of box.querySelectorAll<HTMLElement>(".rank-track i")) {
					bar.style.width = `${bar.dataset.width}%`;
				}
			});
		});
	}

	function renderAi(data: Overview) {
		const ring = $("#ring") as unknown as SVGCircleElement | null;
		const ringValue = $("#ring-value");
		const circumference = 2 * Math.PI * 52;
		if (ring) {
			ring.style.strokeDasharray = String(circumference);
			ring.style.strokeDashoffset = String(circumference * (1 - data.ai.successRate / 100));
		}
		if (ringValue) ringValue.textContent = `${data.ai.successRate}%`;

		const facts = $("#ai-facts");
		if (facts) {
			const rows: [string, string][] = [
				["累计提问", `${fmtNum(data.ai.total)} 次`],
				["今日提问", `${fmtNum(data.ai.today)} 次`],
				["平均响应", data.ai.avgMs ? `${(data.ai.avgMs / 1000).toFixed(1)} 秒` : "—"],
				["平均命中段落", `${data.ai.avgHits} 段`],
				["没检索到内容", `${data.ai.zeroHits} 次`],
				["累计 tokens", fmtNum(data.ai.tokens)],
			];
			facts.innerHTML = rows.map(([label, value]) => `<div><dt>${label}</dt><dd>${value}</dd></div>`).join("");
		}

		const models = $("#models");
		if (models) {
			models.innerHTML =
				data.ai.models.length === 0
					? ""
					: data.ai.models.map((m) => `<span class="model-chip"><b>${m.model}</b><span>${m.count} 次</span></span>`).join("");
		}
	}

	function renderHours(data: Overview) {
		const box = $("#hours");
		if (!box) return;
		const map = new Map(data.views.hours.map((row) => [row.hour, row.count]));
		const max = Math.max(1, ...data.views.hours.map((row) => row.count));
		box.innerHTML = Array.from({ length: 24 }, (_, hour) => {
			const count = map.get(hour) ?? 0;
			const height = count === 0 ? 2 : Math.max(6, Math.round((count / max) * 100));
			return `<i data-h="${height}" title="${hour}:00 · ${count} 次" style="height:2px;opacity:${count ? 0.9 : 0.18}"></i>`;
		}).join("");
		requestAnimationFrame(() => {
			for (const bar of box.querySelectorAll<HTMLElement>("i[data-h]")) {
				bar.style.height = `${bar.dataset.h}%`;
			}
		});
		const note = $("#hours-note");
		if (note) {
			const peak = data.views.hours.reduce((best, row) => (row.count > (best?.count ?? 0) ? row : best), null as null | { hour: number; count: number });
			note.textContent = peak ? `高峰 ${peak.hour}:00 前后 · 共 ${fmtNum(peak.count)} 次` : "按小时分布";
		}
	}

	function renderContent() {
		const monthsBox = $("#months");
		const facts = $("#content-facts");
		const rhythmNote = $("#rhythm-note");
		if (!monthsBox) return;

		// 按月聚合发文数（最近 8 个月，含空月）
		const counter = new Map<string, number>();
		let totalWords = 0;
		let newest = "";
		for (const post of postsCache) {
			const month = (post.published ?? "").slice(0, 7);
			if (month) counter.set(month, (counter.get(month) ?? 0) + 1);
			totalWords += post.words ?? 0;
			if ((post.published ?? "") > newest) newest = post.published ?? "";
		}

		const months: { key: string; label: string; count: number }[] = [];
		for (let i = 7; i >= 0; i--) {
			const date = new Date();
			date.setDate(1);
			date.setMonth(date.getMonth() - i);
			const key = `${date.getFullYear()}-${pad(date.getMonth() + 1)}`;
			months.push({ key, label: `${date.getMonth() + 1}月`, count: counter.get(key) ?? 0 });
		}
		const max = Math.max(1, ...months.map((m) => m.count));
		monthsBox.innerHTML = months
			.map(
				(m) => `<div class="month">
					<b>${m.count || ""}</b>
					<i data-h="${Math.max(3, Math.round((m.count / max) * 100))}" style="height:3px"></i>
					<span>${m.label}</span>
				</div>`,
			)
			.join("");
		requestAnimationFrame(() => {
			for (const bar of monthsBox.querySelectorAll<HTMLElement>("i[data-h]")) bar.style.height = `${bar.dataset.h}%`;
		});

		const avgWords = postsCache.length ? Math.round(totalWords / postsCache.length) : 0;
		const daysSince = newest ? Math.floor((Date.now() - new Date(newest).getTime()) / 86400000) : null;
		if (facts) {
			const rows: [string, string][] = [
				["总字数", `${fmtNum(totalWords)} 字`],
				["平均每篇", `${fmtNum(avgWords)} 字`],
				["最近发布", newest || "—"],
				["停更了", daysSince === null ? "—" : daysSince <= 0 ? "今天刚发" : `${daysSince} 天`],
			];
			facts.innerHTML = rows.map(([label, value]) => `<div><dt>${label}</dt><dd>${value}</dd></div>`).join("");
		}
		if (rhythmNote) {
			const thisMonth = months[months.length - 1]?.count ?? 0;
			const lastMonth = months[months.length - 2]?.count ?? 0;
			rhythmNote.textContent = `本月 ${thisMonth} 篇 · 上月 ${lastMonth} 篇`;
		}
	}

	function renderTags() {
		const box = $("#tags");
		const note = $("#tags-note");
		if (!box) return;

		const counter = new Map<string, number>();
		for (const post of postsCache) {
			for (const tag of post.tags ?? []) counter.set(tag, (counter.get(tag) ?? 0) + 1);
		}
		const entries = Array.from(counter.entries()).sort((a, b) => b[1] - a[1]);
		const used = entries.length;
		const orphans = entries.filter(([, count]) => count === 1).length;
		const max = Math.max(1, ...entries.map(([, count]) => count));

		if (entries.length === 0) {
			box.innerHTML = `<p class="empty">还没有标签</p>`;
		} else {
			box.innerHTML = entries
				.slice(0, 10)
				.map(
					([tag, count]) => `<div class="tagbar">
						<span>${tag}</span>
						<em><i data-w="${Math.round((count / max) * 100)}"></i></em>
						<b>${count}</b>
					</div>`,
				)
				.join("");
			requestAnimationFrame(() => {
				for (const bar of box.querySelectorAll<HTMLElement>("i[data-w]")) bar.style.width = `${bar.dataset.w}%`;
			});
		}

		if (note) {
			const avgPerPost = postsCache.length
				? (entries.reduce((sum, [, count]) => sum + count, 0) / postsCache.length).toFixed(1)
				: "0";
			note.textContent = `${used} 个标签 · 每篇平均 ${avgPerPost} 个${orphans > 0 ? ` · ${orphans} 个只用过 1 次` : ""}`;
		}
	}

	function renderSearches(data: Overview) {
		const box = $("#searches");
		const note = $("#search-note");
		if (note) note.textContent = data.views.search.total > 0 ? `${data.range} 天内 ${fmtNum(data.views.search.total)} 次搜索` : "还没有人搜索过";
		if (!box) return;
		if (data.views.search.top.length === 0) {
			box.innerHTML = `<li class="empty" style="display:block;border:0">还没有搜索记录</li>`;
			return;
		}
		const max = Math.max(...data.views.search.top.map((row) => row.count));
		box.innerHTML = data.views.search.top
			.map(
				(row, index) => `<li style="animation-delay:${index * 40}ms">
					<span class="rank-no">${pad(index + 1)}</span>
					<span class="rank-body">
						<span class="rank-title">${row.keyword.replace(/[<>&]/g, (c) => ({ "<": "&lt;", ">": "&gt;", "&": "&amp;" })[c] ?? c)}</span>
						<span class="rank-track"><i data-width="${Math.round((row.count / max) * 100)}"></i></span>
					</span>
					<span class="rank-count">${row.count}</span>
				</li>`,
			)
			.join("");
		requestAnimationFrame(() => {
			requestAnimationFrame(() => {
				for (const bar of box.querySelectorAll<HTMLElement>(".rank-track i")) bar.style.width = `${bar.dataset.width}%`;
			});
		});
	}

	function renderAiPaths(data: Overview) {
		const box = $("#ai-paths");
		if (!box) return;
		if (data.ai.topPaths.length === 0) {
			box.innerHTML = `<li class="empty" style="display:block;border:0">还没有提问记录</li>`;
			return;
		}
		const max = Math.max(...data.ai.topPaths.map((row) => row.count));
		box.innerHTML = data.ai.topPaths
			.map((row, index) => {
				const title = titles.get(row.path) ?? row.path;
				return `<li style="animation-delay:${index * 40}ms">
					<span class="rank-no">${pad(index + 1)}</span>
					<span class="rank-body">
						<a class="rank-title" href="${row.path}">${title}</a>
						<span class="rank-track"><i data-width="${Math.round((row.count / max) * 100)}"></i></span>
					</span>
					<span class="rank-count">${row.count}</span>
				</li>`;
			})
			.join("");
		requestAnimationFrame(() => {
			requestAnimationFrame(() => {
				for (const bar of box.querySelectorAll<HTMLElement>(".rank-track i")) bar.style.width = `${bar.dataset.width}%`;
			});
		});
	}

	function renderLog(data: Overview) {		const box = $("#log");
		if (!box) return;
		if (data.ai.recent.length === 0) {
			box.innerHTML = `<li class="empty" style="display:block;border:0">还没有人问过</li>`;
			return;
		}
		box.innerHTML = data.ai.recent
			.map((item, index) => {
				const date = new Date(item.ts);
				const time = `${pad(date.getMonth() + 1)}/${pad(date.getDate())} ${pad(date.getHours())}:${pad(date.getMinutes())}`;
				const meta = `${item.ms ? (item.ms / 1000).toFixed(1) + "s" : ""}${item.ok ? "" : " · 失败"}`;
				return `<li style="animation-delay:${(index + 1) * 35}ms">
					<span class="log-time">${time}</span>
					<span class="log-q">${item.question.replace(/[<>&]/g, (c) => ({ "<": "&lt;", ">": "&gt;", "&": "&amp;" })[c] ?? c)}</span>
					<span class="log-meta ${item.ok ? "" : "bad"}">${meta}</span>
				</li>`;
			})
			.join("");
	}

	async function loadTitles() {
		try {
			const response = await fetch("/post-index.json");
			postsCache = (await response.json()) as PostMeta[];
			titles = new Map(postsCache.map((post) => [post.url, post.title]));
		} catch {
			postsCache = [];
		}
	}

	function showConsole(show: boolean) {
		const gate = $("#gate");
		const panel = $("#console");
		if (gate) gate.hidden = show;
		if (panel) panel.hidden = !show;
	}

	async function load() {
		let response: Response;
		try {
			response = await fetch(`/api/admin/overview?range=${range}`, { headers: { accept: "application/json" } });
		} catch {
			showConsole(false);
			return;
		}
		if (response.status === 401) {
			showConsole(false);
			return;
		}

		const data = (await response.json().catch(() => null)) as Overview | null;
		if (!data) {
			showConsole(false);
			return;
		}

		showConsole(true);
		renderLedger(data);
		renderTrend(data);
		renderRanking(data);
		renderHours(data);
		renderContent();
		renderTags();
		renderSearches(data);
		renderAiPaths(data);
		renderAi(data);
		renderLog(data);

		const stamp = $("#stamp");
		if (stamp) {
			const now = new Date();
			stamp.textContent = `${now.getFullYear()}.${pad(now.getMonth() + 1)}.${pad(now.getDate())} ${pad(now.getHours())}:${pad(now.getMinutes())} · GMT+8`;
		}
	}

	for (const button of document.querySelectorAll<HTMLButtonElement>(".seg button")) {
		button.addEventListener("click", () => {
			range = Number(button.dataset.range ?? 14);
			for (const other of document.querySelectorAll(".seg button")) other.classList.toggle("is-active", other === button);
			void load();
		});
	}

	$("#refresh")?.addEventListener("click", () => void load());

	$("#logout")?.addEventListener("click", async () => {
		await fetch("/api/admin/logout", { method: "POST" });
		showConsole(false);
	});

	$("#login-form")?.addEventListener("submit", async (event) => {
		event.preventDefault();
		const input = $("#password") as HTMLInputElement | null;
		const error = $("#login-error");
		if (error) error.hidden = true;
		const response = await fetch("/api/admin/login", {
			method: "POST",
			headers: { "content-type": "application/json" },
			body: JSON.stringify({ password: input?.value ?? "" }),
		});
		if (!response.ok) {
			const body = (await response.json().catch(() => ({}))) as { error?: string };
			if (error) {
				error.textContent = body.error ?? "密码不对";
				error.hidden = false;
			}
			return;
		}
		if (input) input.value = "";
		await load();
	});

	void (async () => {
		await loadTitles();
		await load();
	})();
</script>
