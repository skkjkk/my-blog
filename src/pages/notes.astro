---
import { Icon } from "astro-icon/components";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getNoteIndex } from "@utils/section-utils";
import { url } from "@utils/url-utils";

const noteIndex = await getNoteIndex();
const noteWords = (noteIndex.words / 10000).toFixed(1);
---

<MainGridLayout
    title="面试题库"
    description={`${noteIndex.total} 道面试题的总目录：按分类和知识点分组，一页看完。`}
>
    {/* ---------- 页头 ---------- */}
    <div class="card-base px-6 md:px-9 py-7 mb-4 onload-animation">
        <div class="flex items-center gap-2 mb-3">
            <span class="text-[0.7rem] font-bold tracking-widest text-[var(--primary)]">INDEX</span>
            <span class="h-[1px] flex-1 bg-[var(--line-divider)]"></span>
        </div>
        <h1 class="text-2xl md:text-3xl font-bold text-90 mb-3">面试题库</h1>
        <p class="text-75 mb-5">
            把零散的笔记按知识点归拢成一张目录。共
            <span class="font-bold text-[var(--primary)]">{noteIndex.total}</span> 道题、
            {noteIndex.categories.length} 个分类，约 {noteWords} 万字。点标题直接进答案，输入关键词可以即时筛选。
        </p>

        <div class="flex flex-row gap-3">
            <label class="flex items-center gap-2 flex-1 min-w-0 h-11 px-4 rounded-xl bg-[var(--btn-regular-bg)] transition focus-within:ring-2 focus-within:ring-[var(--primary)]">
                <Icon name="material-symbols:search-rounded" class="text-[1.25rem] text-30" />
                <input
                    id="notes-filter"
                    type="search"
                    autocomplete="off"
                    placeholder="筛选题目，比如：索引、线程池、MCP"
                    class="flex-1 min-w-0 bg-transparent outline-none text-sm text-90 placeholder:text-30"
                />
            </label>
            <div class="flex items-center justify-center gap-1 h-11 px-4 rounded-xl bg-[var(--btn-regular-bg)] font-mono text-sm text-50 shrink-0">
                <span id="notes-count">{noteIndex.total}</span>
                <span class="text-30">题</span>
            </div>
        </div>
    </div>

    {/* ---------- 分类锚点 ---------- */}
    <nav class="sticky top-[4.75rem] z-20 mb-4 onload-animation" style="animation-delay: calc(var(--content-delay) + 60ms)">
        <div class="card-base px-3 py-3 backdrop-blur-md">
            <div class="flex gap-2 overflow-x-auto hide-scrollbar">
                {noteIndex.categories.map((category) => (
                    <a
                        href={`#cat-${category.id}`}
                        class="btn-plain group shrink-0 h-9 px-3 rounded-lg text-sm font-bold"
                    >
                        <span class="flex items-center gap-1.5">
                            {category.name}
                            <span class="font-mono text-xs text-30">{category.count}</span>
                        </span>
                    </a>
                ))}
            </div>
        </div>
    </nav>

    {/* ---------- 空状态 ---------- */}
    <div id="notes-empty" class="hidden card-base px-6 py-10 mb-4 text-center text-50">
        没有匹配的题目。换个关键词试试，或者
        <a href={url("/archive/")} class="link text-[var(--primary)]">按时间归档</a>
        里也有全部内容。
    </div>

    {/* ---------- 分类目录 ---------- */}
    {noteIndex.categories.map((category, categoryIndex) => (
        <section
            id={`cat-${category.id}`}
            data-note-cat
            class="card-base px-6 md:px-9 py-6 mb-4 scroll-mt-32 onload-animation"
            style={`animation-delay: calc(var(--content-delay) + ${100 + categoryIndex * 40}ms)`}
        >
            <div class="flex items-baseline justify-between gap-3 mb-1">
                <h2 class="text-xl font-bold text-90">{category.name}</h2>
                <div class="shrink-0 font-mono text-sm text-30">{category.count} 题</div>
            </div>
            <div class="h-[1px] w-full bg-[var(--line-divider)] mb-4"></div>

            {category.groups.map((group) => (
                <div data-note-group class="mb-4 last:mb-0">
                    {group.tag && (
                        <div class="flex items-center gap-2 mb-2">
                            <span class="text-xs font-bold text-[var(--primary)] tracking-wide">{group.tag}</span>
                            <span class="font-mono text-[0.7rem] text-30">{group.items.length}</span>
                            <span class="h-[1px] flex-1 bg-[var(--line-divider)] opacity-60"></span>
                        </div>
                    )}
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8">
                        {group.items.map((item) => (
                            <a
                                href={item.url}
                                data-note-item
                                data-q={item.title.toLowerCase()}
                                class="group flex items-start gap-2 py-1.5 px-2 -mx-2 rounded-lg transition hover:bg-[var(--btn-plain-bg-hover)] active:bg-[var(--btn-plain-bg-active)]"
                            >
                                <span class="flex-1 text-sm leading-snug text-75 line-clamp-2 transition group-hover:text-[var(--primary)]">
                                    {item.title}
                                </span>
                                <Icon
                                    name="material-symbols:chevron-right-rounded"
                                    class="shrink-0 mt-0.5 text-[1.1rem] text-[var(--primary)] opacity-0 transition group-hover:opacity-100"
                                />
                            </a>
                        ))}
                    </div>
                </div>
            ))}
        </section>
    ))}

    {/* ---------- 页脚 ---------- */}
    <div class="flex flex-wrap gap-3 onload-animation">
        <a href={url("/")} class="btn-card group h-11 px-5 rounded-xl text-sm font-bold">
            <span class="flex items-center gap-2 text-75 transition group-hover:text-[var(--primary)]">
                <Icon name="material-symbols:home-outline-rounded" class="text-[1.25rem] text-[var(--primary)]" />
                回首页
            </span>
        </a>
        <a href={url("/archive/")} class="btn-card group h-11 px-5 rounded-xl text-sm font-bold">
            <span class="flex items-center gap-2 text-75 transition group-hover:text-[var(--primary)]">
                <Icon name="material-symbols:schedule-rounded" class="text-[1.25rem] text-[var(--primary)]" />
                按时间归档
            </span>
        </a>
    </div>
</MainGridLayout>
