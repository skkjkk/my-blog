---
import MainGridLayout from "@layouts/MainGridLayout.astro";
---

<MainGridLayout title="404">
	<div class="flex flex-col items-center justify-center py-16 text-center">
		<div class="text-7xl font-bold text-[var(--primary)]">404</div>
		<p class="mt-6 text-lg text-75">这个页面不存在，或者已经被删掉了。</p>
		<a href="/" class="btn-regular mt-8 rounded-lg px-6 py-2">回到首页</a>
	</div>
</MainGridLayout>
