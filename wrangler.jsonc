{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "wkb",
	"main": "worker/index.js",
	"compatibility_date": "2026-10-30",
	"vars": {
		"AI_BASE_URL": "https://api.hcnsec.cn/v1/chat/completions",
		"AI_MODEL": "auto",
		// firecrawl = Firecrawl Search（需 WEB_SEARCH_API_KEY）；也可配 auto / brave / tavily / searxng
		"WEB_SEARCH_PROVIDER": "firecrawl"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "wkb-db",
			"database_id": "50b9853b-b96a-4525-8ac2-3480b4a09bd9"
		}
	],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "404-page",
		// /mcp 不是静态文件，必须让 Worker 先接；否则会被 asset 404 兜底吃掉
		"run_worker_first": ["/api/*", "/mcp", "/mcp/*"]
	}
}
